# Build: docker build -f deploy/box/Dockerfile.web --build-arg VITE_API_URL=... .
FROM node:20-alpine AS build
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm ci
COPY apps/web/ ./
ARG VITE_API_URL=https://vooai.magnasoluto.com.br/api
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/box/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
