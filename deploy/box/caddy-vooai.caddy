# Snippet isolado — NÃO sobrescrever /opt/sdr/Caddyfile inteiro.
# Preferência: /opt/sdr/caddy-snippets/vooai.caddy + import no Caddyfile principal.
# Fallback: bloco idempotente no Caddyfile (deploy-box.sh).
vooai.magnasoluto.com.br {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle_path /api/* {
		header X-Frame-Options "DENY"
		header Cache-Control "no-store"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy vooai-api:8000 {
			# IP real do cliente: sobrescreve qualquer X-Forwarded-For forjado.
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		reverse_proxy vooai-web:80
	}
}
