SERPAPI_API_KEY=
VOOAI_SPEC_DIR=../../data/Spec
VOOAI_DATA_DIR=../../data
APP_ENV=dev
# Cache de cotações (Redis na box / docker compose). Sem URL → memória local.
REDIS_URL=redis://127.0.0.1:6379/0
VOOAI_QUOTE_CACHE_TTL_SEC=1200
VOOAI_SERPAPI_COST_BRL=0.08
# Auth (obrigatório em prod)
VOOAI_AUTH_SECRET=dev-change-me-auth-secret
VOOAI_ADMIN_TOKEN=dev-change-me
VOOAI_ACCESS_TTL_SEC=900
VOOAI_REFRESH_TTL_SEC=604800
VOOAI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VOOAI_COOKIE_PATH=/
VOOAI_COOKIE_SECURE=0
# Em prod: exige login no /search mesmo com billing off (protege SerpAPI).
VOOAI_SEARCH_REQUIRE_AUTH=0
VOOAI_ALLOW_TOPUP_STUB=1
VOOAI_RELOAD_URL=http://127.0.0.1:8000/admin/reload-spec
# Billing OFF nos testes SerpAPI; ligar com 1 + BILLING_API_*.
VOOAI_BILLING_ENABLED=0
# Box — database dedicado (NÃO use .../sdr):
# VOOAI_DATABASE_URL=postgresql://sdr:sdr_dev_password@127.0.0.1:5432/vooai
VOOAI_DATABASE_URL=
VOOAI_DB_PATH=
VOOAI_RATE_LIMIT_PER_MIN=30
# Telemetria de produto (pageview/search/login/topup). 0 = off.
VOOAI_TELEMETRY_ENABLED=1
# Magic link — Titan (smtp.titan.email). Porta 465 = SSL implícito.
# VOOAI_SMTP_HOST=smtp.titan.email
# VOOAI_SMTP_PORT=465
# VOOAI_SMTP_SSL=1
# VOOAI_SMTP_USER=
# VOOAI_SMTP_PASSWORD=
# VOOAI_SMTP_FROM=
# VOOAI_SMTP_FROM_NAME=VooAI
# Billing API (PIX / Asaas atrás do gateway):
# BILLING_API_URL=
# BILLING_API_TOKEN=
# VOOAI_WEBHOOK_TOKEN=
